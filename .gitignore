# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.egg

# --- Virtual environments ---
.venv/
venv/
env/

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Environment / secrets (never commit real values) ---
.env
*.secret
*.key

# --- Project runtime data (never committed; created at runtime) ---
data/*.sqlite3
data/*.sqlite3-journal
logs/*.log
temp/*

# --- Playwright ---
**/test-results/
**/playwright-report/
**/.cache/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
