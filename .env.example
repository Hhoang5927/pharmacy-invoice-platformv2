# Copy this file to .env and fill in real values locally.
# NEVER commit a real .env file. Real secrets are also readable through
# infrastructure/config/secrets_manager.py (OS keyring) once Prompt 05
# is implemented -- this file only covers local/dev convenience loading
# via python-dotenv, per Technical Design Document Section 10.1.

APP_ENV=development

# --- Gemini OCR ---
GEMINI_API_KEY=

# --- webnhathuoc.com credentials ---
WEBNHATHUOC_USERNAME=
WEBNHATHUOC_PASSWORD=

# --- Paths ---
DATABASE_PATH=./data/project.sqlite3
DEFAULT_WORKING_FOLDER=

# --- Behavior ---
AUTOMATION_HEADLESS=true
LOG_LEVEL=INFO
